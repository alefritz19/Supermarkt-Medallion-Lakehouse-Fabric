// ==============================================================================
// POWER BI & DIRECT LAKE: EXPLICIT DAX MEASURES
// Dataset: sm_supermarkt_sales
// Mode: Direct Lake on Microsoft OneLake / Delta Parquet (FrischMarkt GmbH)
// Author: Alexander Fritzler
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. BASE REVENUE & VOLUME MEASURES
// ------------------------------------------------------------------------------

Total_Umsatz = 
SUM(fct_verkaeufe[Gesamtbetrag])

Total_Menge = 
SUM(fct_verkaeufe[Menge])

Anzahl_Transaktionen = 
DISTINCTCOUNT(fct_verkaeufe[EinkaufID])

Durchschnittsbon = 
DIVIDE([Total_Umsatz], [Anzahl_Transaktionen], 0)

Durchschnittsbon_AOV = 
DIVIDE([Total_Umsatz], [Anzahl_Transaktionen], 0)

Artikel_pro_Bon = 
DIVIDE([Total_Menge], [Anzahl_Transaktionen], 0)

Total_Rohertrag = 
SUM(fct_verkaeufe[Rohertrag])

Rohertragsmarge_Pct = 
DIVIDE([Total_Rohertrag], [Total_Umsatz], 0)

// ------------------------------------------------------------------------------
// 2. TIME INTELLIGENCE & COMPARISONS (YoY / MoM)
// ------------------------------------------------------------------------------

Umsatz_Vorjahr = 
CALCULATE(
    [Total_Umsatz],
    SAMEPERIODLASTYEAR('dim_datum'[Datum])
)

Total_Umsatz_Vorjahr = 
CALCULATE(
    [Total_Umsatz],
    SAMEPERIODLASTYEAR('dim_datum'[Datum])
)

Umsatz_YoY_Wachstum_Absolut = 
[Total_Umsatz] - [Total_Umsatz_Vorjahr]

Umsatz_YoY_Wachstum_Prozent = 
DIVIDE(
    [Umsatz_YoY_Wachstum_Absolut],
    [Total_Umsatz_Vorjahr],
    0
)

Umsatz_YTD = 
TOTALYTD(
    [Total_Umsatz],
    'dim_datum'[Datum]
)

Umsatz_MoM_Vormonat = 
CALCULATE(
    [Total_Umsatz],
    DATEADD('dim_datum'[Datum], -1, MONTH)
)

Umsatz_MoM_Wachstum_Prozent = 
DIVIDE(
    [Total_Umsatz] - [Umsatz_MoM_Vormonat],
    [Umsatz_MoM_Vormonat],
    0
)

// ------------------------------------------------------------------------------
// 3. PRODUCT & CATEGORY PERFORMANCE
// ------------------------------------------------------------------------------

Umsatz_Anteil_Gesamt = 
DIVIDE(
    [Total_Umsatz],
    CALCULATE([Total_Umsatz], ALL(dim_produkte)),
    0
)

Umsatz_Anteil_Filiale = 
DIVIDE(
    [Total_Umsatz],
    CALCULATE([Total_Umsatz], ALL(dim_filialen)),
    0
)
